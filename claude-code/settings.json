{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "fable[1m]",
  "outputStyle": "Justin",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/herdr-session-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "inputNeededNotifEnabled": true,
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  }
}
