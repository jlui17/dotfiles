#!/bin/bash

# Restart the Omarchy shell with Qt Quick's software backend.
#
# The NVIDIA Wayland driver refuses a client's buffer allocation when VRAM is
# full rather than spilling to system RAM (egl-wayland#185), so a game holding
# most of an 8GB card leaves the shell unable to create surfaces: every panel
# and menu open fails with EGL_BAD_ALLOC. Drawing on the CPU into shared memory
# means the shell never asks the GPU for anything, so it cannot be starved.
# Measured cost is 0.23% of one core idle, indistinguishable from GPU rendering.
#
# Omarchy hardcodes `omarchy-launch-shell` in its own autostart and puts its bin
# dir first on PATH, so neither a shim nor an edited autostart survives an
# update. Relaunching after the default has started is what's left.
#
# QT_QUICK_BACKEND is deliberately not set session-wide: it would also catch
# moonlight and kdenlive, which want the GPU.

set -u

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
ping_shell() { OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell shell ping >/dev/null 2>&1; }

# Wait for the shell Omarchy's autostart launched. Racing it instead would leave
# whichever instance lost holding the bar, since both launch Quickshell with
# --no-duplicate and the loser just exits.
for _ in $(seq 1 100); do
  ping_shell && break
  sleep 0.1
done

# The launcher supervises Quickshell and relaunches it on an unclean exit, so
# the supervisor has to go first or it restores the GPU-backed shell underneath
# us; its TERM trap takes Quickshell down with it. Derived from Quickshell's
# parent rather than matched by name: systemd-cat execs, so the launcher is the
# direct parent, and `pkill -f omarchy-launch-shell` also matches any shell
# whose command line merely mentions it.
for pid in $(pgrep -x quickshell); do
  parent=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  [[ -n ${parent:-} ]] || continue
  case "$(tr '\0' ' ' < "/proc/$parent/cmdline" 2>/dev/null)" in
    *omarchy-launch-shell*) kill -TERM "$parent" 2>/dev/null ;;
  esac
done

# Each kill stops the oldest matching instance and returns once it has exited,
# so the launch below cannot race a shell that is still dying.
while timeout 5 quickshell kill -p "$OMARCHY_PATH/shell" --any-display >/dev/null 2>&1; do :; done

# setsid so the new supervisor outlives whatever invoked this.
exec setsid env QT_QUICK_BACKEND=software omarchy-launch-shell
