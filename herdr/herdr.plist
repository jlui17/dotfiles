<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>herdr</string>
	<!-- launchd expands no variables; both Macs run the dotfiles as justinlui. -->
	<key>ProgramArguments</key>
	<array>
		<string>/Users/justinlui/.local/bin/herdr-server-daemon</string>
		<string>/opt/homebrew/bin/herdr</string>
		<string>server</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/opt/homebrew/var/log/herdr.log</string>
	<key>StandardErrorPath</key>
	<string>/opt/homebrew/var/log/herdr.log</string>
</dict>
</plist>
