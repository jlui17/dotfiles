#!/bin/zsh
# herdr-goto — fuzzy-pick any pane in the session and focus it. config.toml
# binds it to prefix+g, where it runs in a popup.

# The popup inherits the herdr server's PATH, and launchd and systemd give the
# server a minimal one: no Homebrew and no mise shims, where fzf lives on macOS
# and Ubuntu.
path+=(/opt/homebrew/bin "$HOME/.local/share/mise/shims")

pick=$("$HERDR_BIN_PATH" api snapshot | jq -r '
  .result.snapshot
  | (.workspaces | map({key: .workspace_id, value: .label}) | from_entries) as $space
  | (.tabs | map({key: .tab_id, value: .label}) | from_entries) as $tab
  # Most urgent first, in the order of the priority sidebar in herdr.
  | {blocked: 0, done: 1, working: 2, idle: 3} as $urgency
  | ["STATUS", "TAB", "SPACE", "AGENT", "PANE"],
    (.panes | sort_by($urgency[.agent_status] // 4)[]
     | [$urgency[.agent_status] // 4, $tab[.tab_id], $space[.workspace_id],
        .display_agent // .agent // "-", .pane_id])
  | map(if . == "" then "-" else . end) | @tsv' |
  # The popup has no locale, and column needs a UTF-8 one to count a multibyte
  # character in a label as one cell.
  LC_ALL=C.UTF-8 column -t -s $'\t' |
  # The urgency digit becomes the symbol of its state here, after column, which
  # counts the bytes of a color escape as width. The shape carries the state.
  # The colors are the Okabe-Ito four from config.toml.
  sed -e $'s/^0/\e[38;2;213;94;0m×\e[m/' -e $'s/^1/\e[38;2;86;180;233m✓\e[m/' \
      -e $'s/^2/\e[38;2;240;228;66m◐\e[m/' -e $'s/^3/\e[38;2;0;158;115m○\e[m/' \
      -e 's/^4/·/' |
  fzf --ansi --header-lines=1 --layout=reverse) || exit 0

# The CLI focuses a pane by id only when it hosts an agent (`agent focus`), so
# pane.focus goes to the socket API directly.
zmodload zsh/net/socket
zsocket "$HERDR_SOCKET_PATH"
print -r -u $REPLY -- '{"id":"herdr-goto","method":"pane.focus","params":{"pane_id":"'${pick##* }'"}}'
read -r -u $REPLY
