#!/bin/sh
# Cache one secret from a 1Password service account in protected runtime storage.
set -eu

usage() {
  printf '%s\n' 'Usage: op-secret-cache [--refresh] <CACHE_KEY> <op://vault/item/field>' >&2
  exit 2
}

locked=false
if [ "${1:-}" = "--locked" ]; then
  locked=true
  shift
fi

refresh=false
if [ "${1:-}" = "--refresh" ]; then
  refresh=true
  shift
fi

[ "$#" -eq 2 ] || usage
cache_key=$1
secret_ref=$2
case "$cache_key" in
  ''|*[!A-Z0-9_]*) usage ;;
esac
case "$secret_ref" in
  op://*/*/*) ;;
  *) usage ;;
esac

runtime_root=/run/user/$(id -u)
if [ -d "$runtime_root" ] && [ -w "$runtime_root" ]; then
  cache_dir=$runtime_root/openclaw
else
  cache_dir=/tmp/openclaw-$(id -u)
fi
[ ! -L "$cache_dir" ] || {
  printf '%s\n' 'op-secret-cache: refusing symlinked cache directory' >&2
  exit 1
}
(umask 077 && mkdir -p "$cache_dir")
chmod 700 "$cache_dir"
[ "$(stat -c '%a' "$cache_dir")" = 700 ] || {
  printf '%s\n' 'op-secret-cache: cache directory does not have mode 0700' >&2
  exit 1
}

if [ "$locked" = false ] && command -v flock >/dev/null 2>&1; then
  if [ "$refresh" = true ]; then
    exec flock -w 120 "$cache_dir/.$cache_key.lock" "$0" --locked --refresh "$cache_key" "$secret_ref"
  else
    exec flock -w 120 "$cache_dir/.$cache_key.lock" "$0" --locked "$cache_key" "$secret_ref"
  fi
fi

cache_file=$cache_dir/$cache_key
if [ -e "$cache_file" ] || [ -L "$cache_file" ]; then
  [ -f "$cache_file" ] && [ ! -L "$cache_file" ] || {
    printf '%s\n' 'op-secret-cache: refusing non-regular cache file' >&2
    exit 1
  }
  chmod 600 "$cache_file"
  [ "$(stat -c '%a' "$cache_file")" = 600 ] || {
    printf '%s\n' 'op-secret-cache: cache file does not have mode 0600' >&2
    exit 1
  }
  if [ "$refresh" = false ]; then
    cat "$cache_file"
    exit
  fi
fi

if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -n "${OP_SECRET_CACHE_TOKEN_FILE:-}" ]; then
  token_file=$OP_SECRET_CACHE_TOKEN_FILE
  [ -f "$token_file" ] && [ ! -L "$token_file" ] && [ -r "$token_file" ] || {
    printf 'op-secret-cache: service-account token file is unavailable: %s\n' "$token_file" >&2
    exit 1
  }
  OP_SERVICE_ACCOUNT_TOKEN=$(sed -n '1p' "$token_file")
  export OP_SERVICE_ACCOUNT_TOKEN
fi
[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] || {
  printf '%s\n' 'op-secret-cache: OP_SERVICE_ACCOUNT_TOKEN is not available' >&2
  exit 1
}
op_bin=${OP_SECRET_CACHE_OP_BIN:-$HOME/.local/bin/op}
[ -x "$op_bin" ] || {
  printf 'op-secret-cache: 1Password CLI is missing: %s\n' "$op_bin" >&2
  exit 1
}

quota_output=$($op_bin service-account ratelimit) || {
  printf '%s\n' 'op-secret-cache: unable to check 1Password service-account quota' >&2
  exit 1
}
account_reads_remaining=$(printf '%s\n' "$quota_output" | awk '$1 == "account" && $2 == "read_write" { print $5; exit }')
case "$account_reads_remaining" in
  ''|*[!0-9]*)
    printf '%s\n' 'op-secret-cache: unable to interpret 1Password account-read quota' >&2
    exit 1
    ;;
esac
[ "$account_reads_remaining" != 0 ] || {
  printf '%s\n' 'op-secret-cache: 1Password account-read quota is exhausted' >&2
  exit 1
}

secret=$($op_bin read "$secret_ref")
[ -n "$secret" ] || {
  printf '%s\n' 'op-secret-cache: 1Password returned an empty secret' >&2
  exit 1
}
cache_tmp=$(umask 077 && mktemp "$cache_dir/.$cache_key.XXXXXX") || exit 1
trap 'rm -f "$cache_tmp"' EXIT HUP INT TERM
chmod 600 "$cache_tmp"
printf '%s\n' "$secret" > "$cache_tmp"
mv -f "$cache_tmp" "$cache_file"
chmod 600 "$cache_file"
trap - EXIT HUP INT TERM
printf '%s\n' "$secret"
