#!/bin/bash
# Update a standalone T3 Code server to the current nightly.
set -euo pipefail

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "Standalone T3 Code updates are only configured on Linux." >&2
  exit 1
fi

source /etc/os-release
if [[ "$ID" != "ubuntu" && "$ID" != "arch" && " ${ID_LIKE:-} " != *" arch "* ]]; then
  echo "Unsupported Linux distribution: $ID" >&2
  exit 1
fi

# systemd gives the timer a minimal environment. The mise shims expose its
# Node runtime without relying on an interactive shell.
PATH="$HOME/.local/share/mise/shims:$PATH"

version="$(npm view t3@nightly version)"
echo "nightly is t3@$version"

unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/t3code.service"
if [[ ! -f "$unit" ]]; then
  exec npx -y "t3@$version" service install
fi

npx -y "t3@$version" update "$version" --yes

# Keep the committed runtime, its immediate predecessor for rollback, and the
# runtime referenced by systemd's service launcher. Older nightly runtimes are
# reproducible and otherwise accumulate hundreds of MB per daily update.
state="$HOME/.t3/runtime/service-state.json"
if [[ -f "$state" ]]; then
  active="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["activeVersion"])' "$state")"
  previous="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["update"]["fromVersion"])' "$state")"
  launcher="$(systemctl --user show t3code.service -p ExecStart --value | sed -n 's#.*runtime/versions/\([^/ ;]*\)/t3.*#\1#p')"
  for runtime in "$HOME"/.t3/runtime/versions/*; do
    [[ -d "$runtime" ]] || continue
    runtime_version="${runtime##*/}"
    [[ "$runtime_version" == "$active" ||
       "$runtime_version" == "$previous" ||
       "$runtime_version" == "$launcher" ]] && continue
    rm -rf -- "$runtime"
  done
fi
