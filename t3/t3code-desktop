#!/bin/sh
set -eu

# The desktop app always starts an embedded server. Keep it away from the
# background service's live database; the existing server is added as a
# separate environment in Settings → Connections. A launch from inside a
# T3-hosted agent also inherits service-only context that must not reach it.
export T3CODE_HOME="$HOME/.t3-desktop"
unset T3_BOOT_SERVICE_UNIT T3_SERVICE_LAUNCHER_CONTEXT T3_MCP_BEARER_TOKEN
exec /usr/bin/t3code-nightly "$@"
